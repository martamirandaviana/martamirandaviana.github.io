<article class="research-entry" data-thumbnail-key="{{ conference.id | escape }}">
  <p class="research-kind">{{ conference.kind | default: "Conference" | escape }} · {{ conference.year | escape }}</p>
  <h3 class="research-entry__title"{% if conference.title_lang %} lang="{{ conference.title_lang | escape }}"{% endif %}>{{ conference.title | escape }}</h3>
  {% if conference.venue %}<p class="research-venue">{{ conference.venue | escape }}</p>{% endif %}
  {% if conference.organizer %}<p class="research-venue">Organized by {{ conference.organizer | escape }}</p>{% endif %}
  <p class="research-authors">{{ conference.role | escape }}{% if conference.date %} · {{ conference.date | escape }}{% endif %}</p>
  {% if conference.work %}<p class="research-meta"{% if conference.work_lang %} lang="{{ conference.work_lang | escape }}"{% endif %}>{{ conference.work | escape }}{% if conference.authors %} · {{ conference.authors | escape }}{% endif %}</p>{% endif %}
  {% if conference.note %}<p class="research-meta">{{ conference.note | escape }}</p>{% endif %}
  {% if conference.pdf %}<div class="research-actions"><a href="{{ conference.pdf | escape }}">Conference paper →</a></div>{% endif %}
</article>
