{% include "research/header.liquid" %}
<nav class="research-topic-nav wrap" aria-label="Research topics">
  <ul>
    {% for theme in research.themes %}<li><a href="#{{ theme.id | escape }}">{{ theme.nav_label | default: theme.title | escape }}</a></li>{% endfor %}
  </ul>
</nav>
<div class="research-theme-archive wrap">
  {% for theme in research.themes %}
  <section class="research-theme" id="{{ theme.id | escape }}" aria-labelledby="theme-title-{{ theme.id | escape }}">
    <header class="research-theme-head">
      <p class="research-theme-number">{{ theme.number | escape }}</p>
      <h2 id="theme-title-{{ theme.id | escape }}">{{ theme.title | escape }}</h2>
    </header>
      {% if theme.thumbnail.image or theme.thumbnail.slides %}
      <figure class="research-theme-thumbnail">
        <div class="research-theme-visual{% if theme.thumbnail.slides %} research-theme-visual--carousel{% endif %}"{% if theme.thumbnail.slides %} data-research-carousel{% endif %}>
          {% if theme.thumbnail.slides %}
          {% for slide in theme.thumbnail.slides %}
          <div class="research-thumbnail-slide{% if forloop.first %} is-active{% endif %}" data-thumbnail-key="{{ slide.key | escape }}"{% unless forloop.first %} aria-hidden="true"{% endunless %}>
            {% if slide.original %}
            <picture><img src="{{ slide.image | escape }}" alt="{{ slide.alt | escape }}" loading="lazy" decoding="async"></picture>
            {% else %}
            {% picture slide.image, slide.alt, "(min-width: 48em) 312px, calc(100vw - 32px)", "card" %}
            {% endif %}
          </div>
          {% endfor %}
          <button class="research-thumbnail-next" type="button" aria-label="Show next {{ theme.nav_label | default: theme.title | downcase | escape }} image" hidden></button>
          <button class="research-thumbnail-pause" type="button" aria-label="Pause {{ theme.nav_label | default: theme.title | downcase | escape }} images" aria-pressed="false" hidden>Pause</button>
          {% else %}
          {% picture theme.thumbnail.image, theme.thumbnail.alt, "(min-width: 48em) 312px, calc(100vw - 48px)", "card" %}
          {% endif %}
        </div>
        <figcaption>{{ theme.thumbnail.caption | escape }}</figcaption>
      </figure>
      {% endif %}
    <div class="research-theme-entries">
      {% if theme.id == "conferences" %}
      {% for conference in research.conferences %}{% include "research/conference-entry.liquid" %}{% endfor %}
      {% elsif theme.id == "teaching" %}
      {% for position in research.teaching %}{% include "research/teaching-entry.liquid" %}{% endfor %}
      {% else %}
      {% assign entries = research.publications | where: "theme", theme.id %}
      {% assign show_year = true %}
      {% for publication in entries %}{% include "research/entry.liquid" %}{% endfor %}
      {% endif %}
    </div>
  </section>
  {% endfor %}
</div>
