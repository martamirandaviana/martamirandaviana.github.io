<li class="card">
  <a class="card__link" href="{{ project.url }}">
    <div class="card__media">{% cover project, "(min-width: 75em) 480px, (min-width: 64.5em) 984px, calc(100vw - 2rem)" %}</div>
    <div class="card__meta">
      {%- assign h = card_heading | default: "h3" -%}
      <{{ h }} class="card__title">{{ project.data.title }}</{{ h }}>
      <span class="card__year">{{ project.data.year }}</span>
      <p class="card__subtitle">{{ project.data.subtitle }}</p>
    </div>
  </a>
</li>
