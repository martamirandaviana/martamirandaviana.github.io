<header class="site-header">
  <a class="brand" href="/" aria-label="{{ site.name }}, {{ t.home }}" {% if page.url == "/" %}aria-current="page"{% endif %}>
    <span class="brand__mark">{{ "logo-mrt.svg" | svg }}</span>
    <span class="brand__text">
      <span class="brand__name">{{ site.name }}</span>
      <span class="brand__role">{{ site.role }}</span>
    </span>
  </a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
    <span class="menu-toggle__label">{{ t.menu }}</span>
    <span class="menu-toggle__icon" aria-hidden="true"></span>
  </button>
  <nav id="site-nav" class="site-nav" aria-label="{{ t.menu }}">
    <ul>
      {%- for item in site.navigation %}
      {%- assign label = t[item.key] %}
      <li><a href="{{ item.url }}"{% if page.url contains item.url %} aria-current="page"{% endif %}>{{ label }}</a></li>
      {%- endfor %}
    </ul>
  </nav>
</header>
